{
  "name": "soclip-cli",
  "version": "0.2.2",
  "description": "TikTok / YouTube / Instagram video download API CLI — direct links and metadata. Hosted alternative to running yt-dlp yourself.",
  "homepage": "https://soclip.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangyunbin/soclip-cli.git"
  },
  "bugs": {
    "url": "https://github.com/huangyunbin/soclip-cli/issues"
  },
  "license": "MIT",
  "keywords": [
    "tiktok",
    "youtube",
    "instagram",
    "tiktok-api",
    "video-download-api",
    "yt-dlp",
    "video",
    "downloader",
    "api",
    "cli",
    "soclip"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "soclip": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --clean",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
